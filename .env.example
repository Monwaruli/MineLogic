# MineLogic Platform — client environment variables.
#
# Copy this file to `.env` (or `.env.local`) and fill in your Supabase project
# values. Only these two PUBLIC Backend credentials belong in the client bundle
# (Requirement 27.8). The Build_Pipeline reads them from repository secrets or
# environment variables (Requirement 27.10).
#
# NEVER put the Supabase service-role key here or anywhere the client can read
# it. The service-role key bypasses Row Level Security and must stay on the
# server / Supabase dashboard only.

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Your Supabase anon (public) API key. Safe to ship in the client bundle; it is
# gated by Row Level Security.
VITE_SUPABASE_ANON_KEY=
